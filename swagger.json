{
  "openapi": "3.0.0",
  "info": {
    "title": "Ready-to-Post Video Generator - Storyfed",
    "description": "End-to-end long-form and short-form video generation API. Submit a prompt and optional parameters to receive a fully formatted, ready-to-post video with character consistency and captions. Generation takes 5-10 minutes. Progress updates and the final video are delivered via a webhook callback.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.storyfed.com",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/storyfed-1": {
      "post": {
        "summary": "Generate Video",
        "description": "Submits a prompt for video generation. The endpoint immediately returns a success status with a job_id, and subsequently posts updates and final assets to the provided webhook_url or via Check Video Status endpoint.",
        "operationId": "generateVideo",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "prompt": {
                    "type": "string",
                    "description": "The prompt or script for the video.",
                    "example": "Make a video about 5 good healthy tips"
                  },
                  "quality_tier": {
                    "type": "string",
                    "description": "The desired rendering quality. Note: Currently, only 'Budget' is supported in the API. This quality is static images only, perfect for explainer videos, stories and news",
                    "enum": ["Budget"],
                    "example": "Budget"
                  },
                  "webhook_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "The URL where status updates and final result payloads will be sent.",
                    "example": "https://webhook.site/123"
                  },
                  "ratio": {
                    "type": "string",
                    "description": "The aspect ratio of the generated video. Default is 9:16",
                    "enum": ["9:16", "16:9", "1:1"],
                    "example": "9:16"
                  },
                  "estimated_length": {
                    "type": "integer",
                    "description": "Estimated length in seconds. Maximum is 180.",
                    "maximum": 180,
                    "example": 60
                  },
                  "country": {
                    "type": "string",
                    "description": "Target country for the video context.",
                    "example": "United States"
                  },
                  "channel": {
                    "type": "string",
                    "description": "(Optional - Advanced) Storyfed id of the parent user channel to save the video."
                  },
                  "channel_series": {
                    "type": "string",
                    "description": "(Optional - Advanced) Storyfed id of the parent user channel_series to save the video."
                  },
                  "template": {
                    "type": "string",
                    "description": "(Optional - Advanced) Storyfed id of the video template."
                  },
                  "narrator": {
                    "type": "string",
                    "description": "(Optional - Advanced) Storyfed id of the narrator."
                  },
                  "attachments": {
                    "type": "array",
                    "description": "List of attachment objects containing image URLs and metadata. This images can be reference images or stock images to be used",
                    "items": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "format": "uri",
                          "pattern": "^.*\\.(jpg|jpeg|png|webp)$",
                          "description": "Must be a direct link to an image file (.jpg, .jpeg, .png, .webp).",
                          "example": "https://example.com/image.jpg"
                        },
                        "main_use": {
                          "type": "string",
                          "description": "Primary use case for the image (e.g., stock, product, character)",
                          "example": "character"
                        },
                        "description": {
                          "type": "string",
                          "description": "Brief description of how to use the image.",
                          "example": "This is the main character, please use this character in the entire video"
                        }
                      }
                    }
                  }
                },
                "required": ["prompt", "quality_tier"]
              },
              "examples": {
                "standardRequest": {
                  "summary": "Standard Generation",
                  "value": {
                    "prompt": "Make a video about 5 good healthy tips",
                    "quality_tier": "Budget",
                    "ratio": "9:16",
                    "estimated_length": 60
                  }
                },
                "withImages": {
                  "summary": "Generation with Attached Images",
                  "value": {
                    "prompt": "Make a cute video about the attached cat",
                    "quality_tier": "Budget",
                    "ratio": "9:16",
                    "attachments": [
                      {
                        "url": "https://storage.googleapis.com/storage_storyfed/stock_media/cat.jpg",
                        "main_use": "character",
                        "description": "Use this image as main character"
                      }
                    ]
                  }
                },
                "squareFormat": {
                  "summary": "Square Format",
                  "value": {
                    "prompt": "Make a news recap video about AI trends",
                    "webhook_url": "add your webhook_url",
                    "quality_tier": "Budget",
                    "ratio": "1:1"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success - Job Started",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "response": {
                      "type": "object",
                      "properties": {
                        "status": { "type": "string", "example": "working" },
                        "job_id": { "type": "string", "example": "1793139855684x541466892482409100" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid parameters, missing fields, or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "message": { "type": "string" }
                  }
                },
                "examples": {
                  "missingFields": {
                    "summary": "Missing required fields",
                    "value": {
                      "status": "error",
                      "message": "Missing values: prompt"
                    }
                  },
                  "invalidRatio": {
                    "summary": "Invalid Ratio",
                    "value": {
                      "status": "error",
                      "message": "Invalid Ratio, must be 9:16, 16:9 or 1:1"
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Payment Required - Not enough credits.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "error" },
                    "message": { "type": "string", "example": "Not enough credits, add credits to your wallet" }
                  }
                }
              }
            }
          }
        },
        "callbacks": {
          "onVideoUpdate": {
            "{$request.body#/webhook_url}": {
              "post": {
                "summary": "Webhook Notification Payload",
                "description": "The payload sent to the user's webhook_url with progress updates or the final rendered assets.",
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "status": { "type": "string", "example": "completed" },
                          "stage": { "type": "string", "example": "finished" },
                          "preview_url": { "type": "string", "format": "uri" },
                          "result": {
                            "type": "object",
                            "properties": {
                              "title": { "type": "string" },
                              "description": { "type": "string" },
                              "hashtags": { "type": "string" },
                              "thumbnail": { "type": "string", "format": "uri" },
                              "url": { "type": "string", "format": "uri" }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "Your server should return a 2xx status code to acknowledge receipt of the webhook."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/storyfed-1/status/{job_id}": {
      "get": {
        "summary": "Check Video Status",
        "description": "Poll this endpoint using the job_id to get the current status of the video generation.",
        "operationId": "checkVideoStatus",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The job_id returned by the generation endpoint."
          }
        ],
        "responses": {
          "200": {
            "description": "Current status of the job. When status is 'completed', the result object will contain the final video assets.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "completed" },
                    "stage": { "type": "string", "example": "finished" },
                    "preview_url": { "type": "string", "format": "uri", "example": "https://storyfed.com/?script=1793197444550x303104625290286300" },
                    "result": {
                      "type": "object",
                      "properties": {
                        "title": { "type": "string", "example": "5 Simple Healthy Tips You Can Start Today" },
                        "description": { "type": "string", "example": "Five practical everyday wellness tips: add produce, choose whole grains and beans, move regularly, swap sugary drinks for water, and build a steady sleep routine." },
                        "hashtags": { "type": "string", "example": "#HealthyHabits, #WellnessTips, #HealthyEating, #Nutrition, #DailyMovement, #SleepHealth, #DrinkWater, #WholeFoods, #Lifestyle, #Health" },
                        "thumbnail": { "type": "string", "format": "uri", "example": "https://storage.googleapis.com/stories-bolivia-storyfed/video_stock/zdwj9j9rvhrmy0d1gbmsb2c90m" },
                        "url": { "type": "string", "format": "uri", "example": "https://storage.googleapis.com/storage_storyfed/rendered/video-1793197913520.mp4" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Your API Key, visit storyfed.com to generate one."
      }
    }
  }
}
